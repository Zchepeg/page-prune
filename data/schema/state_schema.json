{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jev-ad-block/state.schema.json",
  "title": "Ad Candidate",
  "type": "object",
  "required": ["candidate_id", "page", "tag"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "page": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string"},
        "title": {"type": "string"},
        "top_level_domain": {"type": "string"}
      }
    },
    "tag": {"type": "string"},
    "text": {"type": "string", "maxLength": 500},
    "html": {"type": "string", "maxLength": 2000},
    "element_id": {"type": "string"},
    "classes": {"type": "array", "items": {"type": "string"}},
    "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
    "resource_urls": {"type": "array", "items": {"type": "string"}},
    "direct_resource_urls": {"type": "array", "items": {"type": "string"}},
    "resource_ownership_known": {"type": "boolean"},
    "collection_stratum": {"enum": ["targeted", "control", "manual"]},
    "width": {"type": "number", "minimum": 0},
    "height": {"type": "number", "minimum": 0},
    "fixed": {"type": "boolean"},
    "visible": {"type": "boolean"}
  },
  "additionalProperties": false
}
